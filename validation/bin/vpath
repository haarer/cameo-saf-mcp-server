#!/usr/bin/env python3
"""Container <-> host path mapping. See lib/hostmap.py for the reasoning.

  vpath check <path>          classify a path and show both sides
  vpath to-host <path>        the string to hand the host Cameo
  vpath to-harness <path>     the string this process can open
  vpath scratch               the scratch dir for disposable model copies
  vpath verify-model <path>   prove the mapping by having Cameo open a model through it
"""
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))
import hostmap  # noqa: E402


def cfg(path, key, default=""):
    try:
        return json.loads(pathlib.Path(path).read_text()).get(key, default)
    except Exception:
        return default


root = pathlib.Path(__file__).resolve().parent.parent
cameo = cfg(root / "config.json", "cameo", {})
hostmap.configure(
    host_workspace=cameo.get("host_workspace") or None,
    harness_workspace=cameo.get("local_workspace") or None,
    scratch_dir=cameo.get("scratch_dir") or None,
)

if __name__ == "__main__":
    sys.exit(hostmap.main(sys.argv[1:]))
